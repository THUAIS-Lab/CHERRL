# Copy this file to .env and fill in your credentials:
#   cp detection/.env.example detection/.env

# API key for the OpenAI-compatible chat-completions endpoint
AGENT_API_KEY=your_api_key_here

# Base URL of the OpenAI-compatible endpoint (without trailing slash)
AGENT_API_BASE=https://api.openai.com/v1

# Model identifier passed to the endpoint
AGENT_MODEL=qwen3-235b-a22b
